{
  "manifest_version": 3,
  "name": "FocusMap НГУ — Умный слой для карт кампуса",
  "version": "1.0.0",
  "description": "Показывает загруженность аудиторий НГУ в реальном времени поверх официальной карты",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.nsu.ru/n/university/maps/*",
    "*://*.ngu.ru/n/university/maps/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.nsu.ru/n/university/maps/*",
        "*://*.ngu.ru/n/university/maps/*"
      ],
      "js": [
        "lib/supabase.min.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}